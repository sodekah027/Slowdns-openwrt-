#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
    config_load slowdns
    config_get_bool enabled settings enabled 0
    [ "$enabled" -eq 1 ] || return 0

    config_get ns settings ns "ns-bosku.agenvpn.web.id"
    config_get dns_ip settings dns_ip "103.253.244.163"
    config_get local_port settings local_port "2222"
    config_get remote_host settings remote_host "bosku.agenvpn.web.id"
    config_get remote_port settings remote_port "443"
    config_get ssh_user settings ssh_user "root"
    config_get ssh_pass settings ssh_pass ""

    # Tulis ulang pubkey dari UCI ke file
    config_get pubkey settings pubkey ""
    [ -n "$pubkey" ] && echo "$pubkey" > /etc/slowdns/pubkey.pub

    # Start dnstt-client tunnel
    procd_open_instance slowdns
    procd_set_param command /usr/bin/dnstt-client \
        -udp \
        -pubkey-file /etc/slowdns/pubkey.pub \
        "$ns" \
        "$dns_ip:53" \
        "127.0.0.1:$local_port"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Tunggu tunnel siap lalu buat SSH tunnel
    sleep 3
    procd_open_instance ssh_tunnel
    procd_set_param command /usr/bin/sshpass -p "$ssh_pass" \
        ssh -N \
        -o StrictHostKeyChecking=no \
        -o ServerAliveInterval=30 \
        -p "$local_port" \
        "$ssh_user@127.0.0.1"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
