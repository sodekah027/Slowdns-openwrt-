#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    config_load slowdns
    config_get_bool enabled settings enabled 0
    [ "$enabled" -eq 1 ] || return 0

    # Validasi binary
    if [ ! -x /usr/bin/dnstt-client ]; then
        logger -t slowdns -p daemon.err "ERROR: /usr/bin/dnstt-client tidak ditemukan!"
        return 1
    fi

    FSIZE=$(wc -c < /usr/bin/dnstt-client 2>/dev/null || echo 0)
    if [ "$FSIZE" -lt 100000 ]; then
        logger -t slowdns -p daemon.err "ERROR: Binary tidak valid ($FSIZE bytes)!"
        return 1
    fi

    config_get ns          settings ns          "ns-bosku.agenvpn.web.id"
    config_get dns_ip      settings dns_ip      "103.253.244.163"
    config_get local_port  settings local_port  "5300"
    config_get socks_port  settings socks_port  "1080"
    config_get pubkey      settings pubkey      ""

    # Validasi pubkey (harus 64 hex digit)
    PKLEN=$(printf '%s' "$pubkey" | wc -c)
    if [ "$PKLEN" -ne 64 ]; then
        logger -t slowdns -p daemon.err "ERROR: Public key harus 64 hex digit! Sekarang: $PKLEN karakter"
        return 1
    fi

    # Tulis pubkey ke file
    mkdir -p /etc/slowdns
    printf '%s' "$pubkey" > /etc/slowdns/pubkey.pub

    logger -t slowdns -p daemon.info "Starting dnstt-client: ns=$ns dns=${dns_ip}:53 local=127.0.0.1:${local_port}"

    # Instance 1: dnstt-client DNS tunnel
    procd_open_instance "dnstt"
    procd_set_param command /usr/bin/dnstt-client \
        -mtu 512 \
        -udp "${dns_ip}:53" \
        -pubkey-file /etc/slowdns/pubkey.pub \
        "$ns" \
        "127.0.0.1:${local_port}"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    # Instance 2: SSH SOCKS5 tunnel
    procd_open_instance "shtunnel"
    procd_set_param command /bin/sh /usr/bin/ssh-tunnel-wrapper.sh
    procd_set_param respawn 3600 10 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

}

stop_service() {
    /bin/sh /usr/bin/slowdns-internet.sh stop 2>/dev/null
    killall dnstt-client 2>/dev/null
    killall ssh 2>/dev/null
}

service_triggers() {
    procd_add_reload_trigger "slowdns"
}
